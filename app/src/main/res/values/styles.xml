<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:colorAccent">@color/accent_indigo</item>
        <item name="android:statusBarColor">#0B0C10</item>
        <item name="android:navigationBarColor">#0B0C10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_second</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:buttonStyle">@style/GlowButton</item>
        <item name="android:checkboxStyle">@android:style/Widget.Material.CompoundButton.CheckBox</item>
    </style>

    <style name="GlowButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#F2F0FF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GhostButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/accent_glow</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/accent_indigo</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

</resources>